# A provider is a plugin Terraform uses to create and read resources.
# These two providers run on the machine where you run Terraform.
# They do not need credentials.
terraform {
  required_version = "1.17.0"

  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "2.9.1"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
  }
}

# A provider block turns that plugin on. These two have no settings.
provider "local" {}

provider "random" {}

# A resource is one thing Terraform creates and then tracks.
# random_id makes a project identifier. byte_length 4 is 8 hex characters.
# The identifier stays the same on later applies because Terraform saves it in state.
resource "random_id" "project" {
  byte_length = 4
}

# local_file writes a text file on this machine.
# The lines use the project variables and the identifier from random_id.project.
resource "local_file" "project" {
  filename = "${path.module}/generated-project.txt"

  content = join("\n", [
    "Project name: ${var.project_name}",
    "Environment: ${var.environment}",
    "Project identifier: ${random_id.project.hex}",
    "This file was generated by Terraform.",
  ])
}

# Terraform state is the terraform.tfstate file in this directory.
# It records the random id and the file this configuration created.
# That file is not committed. Each new empty state gets a new id.
